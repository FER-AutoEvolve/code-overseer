{
    "Prompting": {
        "CodebaseDescription": "Codebase description goes here.",
        "CodeCommandStrategy": "update_file",
        "Provider": "openai_gpt_4_1",
        "ProviderConfig": {
            "Url": "",
            "ApiKey": "",
            "Model": "gpt-4.1",
            "Temperature": 0.4,
            "MaxTokens": 3000,
            "TopP": 1.0,
            "Timeout": 60,
            "Headers": {
                "Authorization": "Bearer YOUR_KEY"
            }
        }
    },
    "CodeOverseer": {
        "CodeDirectory": "./codebase",
        "IgnorePatterns": [
            "**/node_modules/",
            "**/dist/",
            ".vscode/",
            ".git/"
        ],
        "IncludeOnlyPatterns": [
            "*.ts",
            "*.png"
        ],
        "RepromptOnChange": true
    },
    "FastApi": {
        "Host": "0.0.0.0",
        "Port": 3000
    },
    "KeypointNotification": {
        "Enabled": false,
        "Endpoint": "http://game-web-wrapper:8001/notify-of-event"
    },
    "ExperimentNotification": {
        "Enabled": true,
        "Endpoint": "http://experiment-director:8002/notify",
        "ComponentName": "CODE_OVERSEER"
    },
    "CodeBuildTesting":{
        "Enabled": true,
        "Endpoint": "http://code-build-tester:2000/try-build",
        "Timeout": 10000
    }
}